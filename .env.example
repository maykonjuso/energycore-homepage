# Homepage da EnergyCore. Copie para .env (na raiz deste projeto).

# Assistente de IA (Claude). Sem chave, o assistente responde pela base local (server/knowledge.md).
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# E-mail do formulário de contato. Sem SMTP, as mensagens ficam em server/.data/outbox.
CONTACT_TO=contato@energycoreconsulting.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EnergyCore <nao-responda@energycoreconsulting.com.br>

# Produção
# ALLOWED_ORIGINS=https://energycoreconsulting.com.br,https://www.energycoreconsulting.com.br
# TRUST_PROXY=1
